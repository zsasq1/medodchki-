div.loading-slide {
display: none;
}
}
div
{
margin-top: 0;
margin-bottom: 0;
font-family:Arial, sans-serif;
}
 p
{
margin-top: 0;
margin-bottom: 0;
word-wrap:break-word;
}
table
{
border-collapse: collapse;
border-color: black;
border-style: solid;
border-width: thin;
}
td
{
word-wrap:break-word;
font-family:Arial;
vertical-align:top;
border-style: solid;
border-width: thin;
}
div.slide
{
position:relative;
}div.slide, div.loading-slide
{
overflow:hidden;
page-break-inside: avoid;
margin-top: 5px;
}
div.slide:first-of-type {
 &nbsp;margin-top: 0;
}
div.loading-slide
{
position: absolute;
background:#BBBBBB;
}
@media screen {
body {
background: #ACB2BB;
}
}
</style><style type="text/css">div.slide, div.loading-slide { width: 720; height: 540;}</style></head><body><style type="text/css">
