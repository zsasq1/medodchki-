ion:absolute; top:290; left:51; width:173; height:56;"><div class="s98"><div class="s13"><p class="s95"><span class="s96">Гипофизарный</span></p><p class="s97"><span class="s96">гипокоритцизм</span></p></div></div></div><img src="x-apple-ql-id://9348165C-1871-446C-9DCD-C7EB01C99557/x-apple-ql-magic/90C66443-543B-4A79-A3DC-92FC7CC00F4C.pdf" style="position:absolute; top:187; left:413; width:249; height:102;"><div style="position:absolute; top:210; left:443; width:189; height:56;"><div class="s99"><div class="s13"><p class="s68"><span class="s55">Гипофизарная </span></p><p class="s70"><span class="s55">кахексия</span></p></div></div></div><img src="x-apple-ql-id://6B899EC7-C475-438C-9E26-C1AB0831E9F1/x-apple-ql-magic/742062CC-596B-4788-A11C-EE037885EEDD.pdf" style="position:absolute; top:351; left:28; width:226; height:102;"><div style="position:absolute; top:375; left:57; width:168; height:56;"><div class="s100"><div class="s13"><p class="s95"><span class="s96">Гипофизарный</span></p><p class="s97"><span class="s96">гипотиреоз</span></p></div></div></div><img src="x-apple-ql-id://FF18814F-B54F-44F4-B4E5-D2B6592784F3/x-apple-ql-magic/521F3C77-18E0-45EA-889A-DBF1FA56ED23.pdf" style="position:absolute; top:431; left:28; width:232; height:107;"><div style="position:absolute; top:454; left:57; width:173; height:61;"><div class="s101"><div class="s13"><p class="s95"><span class="s96">Гипофизарный</span></p><p class="s97"><span class="s96">гипогонадизм</span></p></div></div></div><img src="x-apple-ql-id://A4BA0228-BE71-4A3B-94C4-F8EC148EC2C8/x-apple-ql-magic/452FE397-FAB4-4B82-9500-F827CE8D143E.pdf" style="position:absolute; top:278; left:413; width:255; height:119;"><div style="position:absolute; top:302; left:444; width:194; height:71;"><div class="s102"><div class="s13"><p class="s68"><span class="s55">Послеродовый</span></p><p class="s70"><span class="s55">некроз гипофиза</span></p></div></div></div></div><div class="slide" style="top:0; left:0;"><div class="s0"></div><img src="x-apple-ql-id://B771039C-0D9E-4B0A-85D8-DE2001CF5FF1/x-apple-ql-magic/F98AACF9-70D3-4D01-A2BB-35831E376D5F.png" style="position:absolute; top:0; left:0; width:31; height:540;"><div style="overflow:hidden; position:absolute; top:20; left:31; width:671; height:491;"><img style="position:absolute; top:-150; left:-293; width:3231; height:1615;" src="x-apple-ql-id://AD89AE8F-65DA-4D96-8F68-577BC43128C6/x-apple-ql-magic/F5D1FBB5-A471-42AE-B797-2A248CB47C7A.png"></div></div><style type="text/css">
