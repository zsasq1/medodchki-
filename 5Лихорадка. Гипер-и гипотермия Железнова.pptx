ple-ql-id://8D2FAC35-6FCF-46DF-9A9B-A3E26BDF3F53/x-apple-ql-magic/FC600C38-F2B4-406B-8028-39FF64B6D51B.pdf" style="position:absolute; top:179; left:243; width:44; height:64;"><img src="x-apple-ql-id://F52640F4-3457-47FC-9665-C049F6903C01/x-apple-ql-magic/C2CA0D33-4722-452D-B3B6-9AA5788B428C.pdf" style="position:absolute; top:121; left:334; width:44; height:64;"><img src="x-apple-ql-id://5B4156B9-A416-441E-8E69-1A14A4D51ECA/x-apple-ql-magic/B7F99286-5B80-455F-A45B-1CEA035E3A96.pdf" style="position:absolute; top:62; left:157; width:80; height:58;"><div style="position:absolute; top:210; left:4; width:225; height:45; background-color:#ffcc66; border-style:solid;border-width:thin;border-color:black;"><div class="s228"><div class="s29"><p class="s2"><span class="s191">Накопление метаболитов</span></p></div></div></div><img src="x-apple-ql-id://56361703-EA05-4E0B-8759-A717A930D01D/x-apple-ql-magic/FC24B465-D3F4-49D9-90AF-D5451B59A266.pdf" style="position:absolute; top:298; left:521; width:69; height:44;"><div style="position:absolute; top:335; left:9; width:174; height:54; background-color:#ffcc66; border-style:solid;border-width:thin;border-color:black;"><div class="s229"><div class="s29"><p class="s2"><span class="s194">Повышение </span></p><p class="s184"><span class="s194">теплоотдачи</span></p></div></div></div><img src="x-apple-ql-id://FD12816D-2533-4B13-92D2-2A609AB5AD25/x-apple-ql-magic/4B39FCAE-1BCE-4790-B8F0-65F960A04889.pdf" style="position:absolute; top:128; left:350; width:193; height:59;"><div style="position:absolute; top:337; left:212; width:202; height:52; background-color:#ffcc66; border-style:solid;border-width:thin;border-color:black;"><div class="s230"><div class="s29"><p class="s2"><span class="s194">Снижение </span></p><p class="s184"><span class="s194">температуры тела</span></p></div></div></div><div style="position:absolute; top:505; left:458; width:119; height:28; background-color:#ffcc66; border-style:solid;border-width:thin;border-color:black;"><div class="s196"><div class="s29"><p class="s2"><span class="s194">Смерть</span></p></div></div></div><div style="position:absolute; top:405; left:9; width:150; height:28;"><div class="s50"><p class="s197"> </p></div></div><div style="position:absolute; top:33; left:-4; width:126; height:46;"><div class="s50"><p class="s45"><span class="s198">Стадия компенсации</span></p></div></div><img src="x-apple-ql-id://FEC3C96C-CF6B-4251-A251-39D9B801535A/x-apple-ql-magic/B3CF8E3B-8EE0-4F02-ACB9-98E5C4F6F4AD.pdf" style="position:absolute; top:472; left:541; width:70; height:44;"><div style="position:absolute; top:293; left:456; width:245; height:100; background-color:#ffcc66; border-style:solid;border-width:thin;border-color:black;"><div class="s231"><div class="s29"><p class="s2"><span class="s194">Снижение активности </span></p><p class="s182"><span class="s194">метаболических реакций</span></p><p class="s182"><span class="s194">Угнетение ЦНС,</span></p><p class="s182"><span class="s194">прекращение дрожи </span></p></div></div></div><img src="x-apple-ql-id://C9040744-3059-472B-AFFF-2305167A35FD/x-apple-ql-magic/9DAE2EC6-B0E5-4925-82C4-0E10EE0B1808.pdf" style="position:absolute; top:118; left:405; width:44; height:64;"><img src="x-apple-ql-id://0F70BF8E-1DBB-405E-8C64-DB533EBC4376/x-apple-ql-magic/C2BA1A54-D23F-4EFB-888F-C506DE12C5A0.pdf" style="position:absolute; top:174; left:224; width:44; height:64;"><img src="x-apple-ql-id://CCD91843-8EB8-4BAC-9679-2AE0D03DA06E/x-apple-ql-magic/DF1E968F-8CCB-4629-9FDB-EAD3FBE0D824.pdf" style="position:absolute; top:249; left:442; width:64; height:68;"><div style="position:absolute; top:241; left:577; width:144; height:46;"><div class="s50"><p class="s45"><span class="s200">Стадия декомпенсации</span></p></div></div><img src="x-apple-ql-id://04687E51-C10C-4CC3-86C8-F3A69B2052E8/x-apple-ql-magic/D05A0DAE-B245-4EAA-8612-FDC8FB13AFA7.pdf" style="position:absolute; top:63; left:157; width:66; height:56;"><img src="x-apple-ql-id://00C3EB92-88B4-4FCA-877B-1C9D540F4FC8/x-apple-ql-magic/D9FD09E7-6E0C-4550-A7D5-159800974CF5.pdf" style="position:absolute; top:113; left:340; width:40; height:410;"><img src="x-apple-ql-id://0E20DE5C-0EDF-4173-BCD8-40ADD2626701/x-apple-ql-magic/A7B2FD61-54E5-4BBB-B342-B133931302CC.pdf" style="position:absolute; top:197; left:555; width:44; height:62;"><img src="x-apple-ql-id://0065B3A1-F3ED-46A5-9344-D4678CF32010/x-apple-ql-magic/ED765961-7F3F-4D7F-A2FF-2247AE995642.pdf" style="position:absolute; top:63; left:526; width:74; height:55;"><div style="position:absolute; top:434; left:132; width:288; height:54; background-color:#ffcc66; border-style:solid;border-width:thin;border-color:black;"><div class="s232"><div class="s29"><p class="s2"><span class="s194">Нарушения ритма сердца, </span></p><p class="s184"><span class="s194">отек легких, поражение ЦНС </span></p></div></div></div><img src="x-apple-ql-id://60B01D4E-F2E8-4C29-94AB-DC5B7AD36778/x-apple-ql-magic/5EFA9F09-D68C-491F-B07E-D24EAB98927E.pdf" style="position:absolute; top:249; left:598; width:44; height:68;"><div style="position:absolute; top:97; left:390; width:110; height:42; background-color:#c6e58f; border-style:solid;border-width:thin;border-color:black;"><div class="s233"><div class="s29"><p class="s2"><span class="s176">Мышечная </span></p><p class="s184"><span class="s176">дрожь</span></p></div></div></div><img src="x-apple-ql-id://521EA091-6EE1-4239-B901-AA1933185C7F/x-apple-ql-magic/2A1D830D-693F-43D8-8A86-8A9D87A75DB1.pdf" style="position:absolute; top:59; left:404; width:44; height:60;"><img src="x-apple-ql-id://025BCB3A-9639-49C1-8CFE-4F8BFBAB9FB0/x-apple-ql-magic/1BAD64D5-601D-4945-83B7-EC5DF5879D8E.pdf" style="position:absolute; top:17; left:349; width:44; height:67;"><img src="x-apple-ql-id://EB55AB67-5A6F-46FA-9397-A72304DC370A/x-apple-ql-magic/D5555D99-3C2D-4C62-9B4E-3862755867FA.pdf" style="position:absolute; top:63; left:315; width:44; height:60;"><div style="position:absolute; top:277; left:4; width:221; height:45; background-color:#ffcc66; border-style:solid;border-width:thin;border-color:black;"><div class="s234"><div class="s29"><p class="s2"><span class="s191">Расширение </span></p><p class="s184"><span class="s191">периферических сосудов</span></p></div></div></div><img src="x-apple-ql-id://0B15B861-D831-4453-97D5-B98402670BA7/x-apple-ql-magic/CC40931A-3278-4C19-80B1-813B9C33E4F4.pdf" style="position:absolute; top:120; left:3; width:44; height:109;"><div style="position:absolute; top:407; left:445; width:263; height:35; background-color:#ffcc66; border-style:solid;border-width:thin;border-color:black;"><div class="s235"><div class="s29"><p class="s193"><span class="s194">Снижение теплопродукции</span></p></div></div></div><img src="x-apple-ql-id://FA12F685-EBC8-4C65-B583-CC415BB59A38/x-apple-ql-magic/B401797C-EEE0-4E2F-87C5-D01176758461.pdf" style="position:absolute; top:156; left:128; width:103; height:108;"><img src="x-apple-ql-id://2EBCDB75-DE6F-4A60-889E-7C153FEC7AC5/x-apple-ql-magic/A5AB6B2B-089B-48B5-B7C4-3936E0346A3E.pdf" style="position:absolute; top:336; left:402; width:73; height:44;"><img src="x-apple-ql-id://D84A1DD1-F40B-40AA-8CCF-8B2474B79A9B/x-apple-ql-magic/0FB4BB00-7750-4096-9A96-63471C7F7AAB.pdf" style="position:absolute; top:369; left:553; width:44; height:64;"><img src="x-apple-ql-id://E5D7E16B-CB78-4C82-B49A-B1BE1A94C2D5/x-apple-ql-magic/0E3C490E-9DEC-4CF2-B904-2D718B75973A.pdf" style="position:absolute; top:469; left:400; width:78; height:56;"><img src="x-apple-ql-id://6F7F44B3-0BEC-46A1-AC71-45658EA2823F/x-apple-ql-magic/EBA915E1-7F81-430C-B8E3-BB441EE0AC3D.pdf" style="position:absolute; top:299; left:122; width:44; height:64;"><img src="x-apple-ql-id://BAEF8854-794B-42AA-91AE-B5DCC18EDBD4/x-apple-ql-magic/8771B255-A206-4CF2-BD52-9ED645D564BA.pdf" style="position:absolute; top:233; left:177; width:44; height:64;"></div><div class="slide" style="top:0; left:0;"><div class="s0"></div><img src="x-apple-ql-id://53ECAB2D-4863-48BD-A51B-1B4B4F9BEB45/x-apple-ql-magic/2501045C-E40A-43BB-B5D7-3158E99E50D2.pdf" style="position:absolute; top:-20; left:-20; width:761; height:68;"><div style="position:absolute; top:84; left:127; width:481; height:49;"><div class="s1"><p class="s207"><span class="s208">Медицинская г</span><span class="s208">ибернация</span></p></div></div><img src="x-apple-ql-id://BAEF8854-794B-42AA-91AE-B5DCC18EDBD4/x-apple-ql-magic/8771B255-A206-4CF2-BD52-9ED645D564BA.pdf" style="position:absolute; top:233; left:177; width:44; height:64;"><div style="position:absolute; top:150; left:19; width:669; height:306;"><div class="s1"><p class="s197"><span class="s61">Управляемая (искусственная) гипотермия применяется в медицине в двух разновидностях: общей и местной.</span></p><p class="s205"> </p><p class="s204"><span class="s61">Управляемое снижение температуры тела или его части производится с целью:</span></p><p class="s204"><span class="s61">• уменьшения интенсивности обмена веществ,</span></p><p class="s204"><span class="s61">• уровня функции тканей, органов и их физиологических систем,</span></p><p class="s204"><span class="s61">• повышения их устойчивости к гипоксии.</span></p></div></div><img src="x-apple-ql-id://6F7F44B3-0BEC-46A1-AC71-45658EA2823F/x-apple-ql-magic/EBA915E1-7F81-430C-B8E3-BB441EE0AC3D.pdf" style="position:absolute; top:299; left:122; width:44; height:64;"></div><style type="text/css">
