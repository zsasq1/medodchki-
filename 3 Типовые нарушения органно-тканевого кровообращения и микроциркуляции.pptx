sition:absolute; top:207; left:209; width:209; height:119;"><div style="position:absolute; top:231; left:233; width:161; height:71;"><div class="s104"><div class="s9"><p class="s102"><span class="s100">Повышение градиента давления </span><span class="s100">(</span><span class="s105">Δ</span><span class="s105">P)</span></p></div></div></div><img src="x-apple-ql-id://82DD6BE7-E2C0-4EEE-9414-D864C682ED2D/x-apple-ql-magic/AFFBB5DC-FAFE-4295-BD6C-B6EAADBE36AC.pdf" style="position:absolute; top:207; left:500; width:231; height:119;"><div style="position:absolute; top:231; left:524; width:183; height:71;"><div class="s106"><div class="s9"><p class="s6"><span class="s100">Снижение резистентности (</span><span class="s100">R)</span><span class="s100"> </span></p></div></div></div><img src="x-apple-ql-id://2B011B10-6E39-48AC-9C1D-AD2F02D8EF4A/x-apple-ql-magic/6C497338-E37D-42F1-B158-5613E1FB9498.pdf" style="position:absolute; top:298; left:353; width:221; height:104;"><div style="position:absolute; top:321; left:376; width:174; height:57;"><div class="s107"><div class="s9"><p class="s102"><span class="s100">Усиление кровотока </span><span class="s100">(Q)</span></p></div></div></div><img src="x-apple-ql-id://5A205CE2-0CC8-4B83-A228-61062ADAF77C/x-apple-ql-magic/82377108-BF10-4EC3-A1D4-08958A33708B.pdf" style="position:absolute; top:331; left:124; width:239; height:116;"><div style="position:absolute; top:354; left:148; width:191; height:68;"><div class="s108"><div class="s9"><p class="s6"><span class="s100">Улучшение кровоснабжения и метаболизма</span></p></div></div></div><img src="x-apple-ql-id://166ED17B-8B2F-4BF0-80A5-E900017065F5/x-apple-ql-magic/B3288B37-2A9F-4113-A96D-11C39641D15D.pdf" style="position:absolute; top:424; left:-5; width:255; height:116;"><div style="position:absolute; top:447; left:17; width:207; height:68;"><div class="s109"><div class="s9"><p class="s6"><span class="s100">Усиление функции, гипотрофия, гиперплазия</span></p></div></div></div><img src="x-apple-ql-id://476C2C9D-B846-49D0-A270-83DE2C40ACBD/x-apple-ql-magic/399CBE51-2B7F-4360-83EA-9D99CD342DF1.pdf" style="position:absolute; top:369; left:504; width:221; height:119;"><div style="position:absolute; top:393; left:528; width:173; height:71;"><div class="s110"><div class="s9"><p class="s6"><span class="s100">Повышенный риск кровотечений</span></p></div></div></div><img src="x-apple-ql-id://BB10125E-6097-4217-B6EC-506FEFC83F15/x-apple-ql-magic/0B099F41-F210-4947-AE1E-65DC56C8EEDA.pdf" style="position:absolute; top:140; left:144; width:68; height:51;"><img src="x-apple-ql-id://5D85261F-C13F-4132-8AE0-ED49D5D5EBC8/x-apple-ql-magic/6D5FC385-A8B8-452E-B901-DE83DC77E7DF.pdf" style="position:absolute; top:140; left:317; width:68; height:51;"><img src="x-apple-ql-id://09DDA08B-9A42-4E23-B284-089FE7099009/x-apple-ql-magic/6B573FC4-7A05-4A89-9B47-99099F8B2120.pdf" style="position:absolute; top:138; left:494; width:68; height:51;"><img src="x-apple-ql-id://67C79D8F-941B-4068-87A0-7084381C95A5/x-apple-ql-magic/DAD1FAB2-2789-4802-B8CA-3A4B78B00EAB.pdf" style="position:absolute; top:179; left:322; width:62; height:62;"><img src="x-apple-ql-id://A54603C9-F995-415E-B53B-285A6E6BBA02/x-apple-ql-magic/A13F3A51-6B51-46AA-9B2F-D6A66E41CF3D.pdf" style="position:absolute; top:184; left:566; width:64; height:60;"><img src="x-apple-ql-id://C87ACB9B-A5A3-447A-AAFA-E944E43FAA59/x-apple-ql-magic/7453E763-C9C1-41AB-9849-7CA2C0301B63.pdf" style="position:absolute; top:274; left:478; width:62; height:62;"><img src="x-apple-ql-id://3D264946-DD7D-477B-AE68-80EC133256AE/x-apple-ql-magic/D5320EE6-3C5E-44DF-9475-23CE1CA1D5A2.pdf" style="position:absolute; top:348; left:329; width:62; height:62;"><img src="x-apple-ql-id://77BFF426-59B7-4388-AE5D-9454E4EFAD74/x-apple-ql-magic/80DE9890-732D-4F78-B293-6D020253857A.pdf" style="position:absolute; top:397; left:99; width:62; height:62;"><img src="x-apple-ql-id://A424E639-CCBC-40B8-AD6B-35C1E3ACF06E/x-apple-ql-magic/C7D76E3A-A7FA-4A73-B5B7-3C67D6C74870.pdf" style="position:absolute; top:275; left:384; width:64; height:60;"><img src="x-apple-ql-id://CEBD107A-2D09-4222-B85D-EFDE41A00FD2/x-apple-ql-magic/5F08A17F-F80A-4132-BBC3-3DDBE3ED786C.pdf" style="position:absolute; top:344; left:542; width:64; height:60;"></div><style type="text/css">
