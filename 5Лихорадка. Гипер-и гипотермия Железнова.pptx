</style><div class="slide" style="top:0; left:0;"><div class="s0"></div><img src="x-apple-ql-id://53ECAB2D-4863-48BD-A51B-1B4B4F9BEB45/x-apple-ql-magic/2501045C-E40A-43BB-B5D7-3158E99E50D2.pdf" style="position:absolute; top:-20; left:-20; width:761; height:68;"><div style="position:absolute; top:127; left:48; width:623; height:146;"><div class="s62"><p class="s64"> </p></div></div><table class="s114"><col style="width:162px;"><col style="width:226px;"><col style="width:285px;"><tr><td class="s101"><div class="s98"><p class="s99"><span class="s100">Стадия лихорадки</span></p></div></td><td class="s101"><div class="s102"><p class="s99"><span class="s100">Соотношение теплопродукции (ТП) и теплоотдачи (ТО)</span></p></div></td><td class="s101"><div class="s103"><p class="s99"><span class="s100">Проявления</span></p></div></td></tr><tr><td class="s106"><div class="s98"><p class="s104"><span class="s105">Повышения температуры</span></p></div></td><td class="s106"><div class="s102"><p class="s107"><span class="s105">ТП > ТО</span></p><p class="s104"><span class="s105">Теплопродукция повышена, теплоотдача снижена</span></p></div></td><td class="s106"><div class="s103"><p class="s108"><span class="s105">Усиление катаболизма,</span></p><p class="s108"><span class="s105">мышечная дрожь (±)</span></p><p class="s109"><span class="s105">Сужение периферических сосудов → кожа бледная, сухая; ощущение холода</span></p></div></td></tr><tr><td class="s110"><div class="s98"><p class="s104"><span class="s105">Стояния температуры</span></p></div></td><td class="s110"><div class="s102"><p class="s111"><span class="s105">ТП = ТО Теплопродукция повышена, теплоотдача повышена</span></p></div></td><td class="s110"><div class="s103"><p class="s108"><span class="s105">Усиление катаболизма</span></p><p class="s109"><span class="s105">Расширение периферических сосудов → кожа розовая, влажная; ощущение тепла/жара</span></p></div></td></tr><tr><td class="s112"><div class="s98"><p class="s104"><span class="s105">Снижения температуры</span></p></div></td><td class="s112"><div class="s102"><p class="s107"><span class="s105">ТП </span><span class="s113"></span><span class="s105"> ТО</span></p><p class="s104"><span class="s105">Теплопродукция снижена, теплоотдача повышена</span></p></div></td><td class="s112"><div class="s103"><p class="s109"><span class="s105">Расширение периферических сосудов → кожа розовая, влажная; ощущение жара</span></p></div></td></tr></table></div><style type="text/css">
