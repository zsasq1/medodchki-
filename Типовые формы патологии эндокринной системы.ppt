g src="x-apple-ql-id://49C705F7-5630-4DB5-8ECA-812E3DB5FA5F/x-apple-ql-magic/9B23936A-D149-40BC-A346-1970393FF239.pdf" style="position:absolute; top:363; left:11; width:210; height:187;"><div style="position:absolute; top:390; left:39; width:153; height:133;"><div class="s228"><div class="s13"><p class="s68"><span class="s57">Фибрилляция </span></p><p class="s70"><span class="s57">мышц, </span></p><p class="s70"><span class="s57">судороги, </span></p><p class="s70"><span class="s57">тетанус</span></p></div></div></div><img src="x-apple-ql-id://0C43A91B-F368-4E81-B9E8-CF6D90989CE9/x-apple-ql-magic/6B83A800-EB42-495B-94CA-6CFA1555913F.pdf" style="position:absolute; top:334; left:84; width:74; height:74;"><img src="x-apple-ql-id://4A05EE57-F068-4EF2-AAFA-879663E16AB0/x-apple-ql-magic/455CD6B1-FB2F-4F5A-B49A-57417BF50417.pdf" style="position:absolute; top:369; left:215; width:249; height:170;"><div style="position:absolute; top:395; left:245; width:189; height:117;"><div class="s229"><div class="s13"><p class="s68"><span class="s57">Пилороспазм, </span></p><p class="s70"><span class="s57">ларингоспазм,</span></p><p class="s70"><span class="s57">нарушения </span></p><p class="s70"><span class="s57">мочеиспускания</span></p></div></div></div><img src="x-apple-ql-id://3B7F5874-688A-4411-BC05-3A420460A60C/x-apple-ql-magic/753275A1-4C9B-4D7D-B6BC-B5192E4A7CC2.pdf" style="position:absolute; top:272; left:430; width:283; height:108;"><div style="position:absolute; top:295; left:462; width:219; height:61;"><div class="s230"><div class="s13"><p class="s68"><span class="s57">Нервно-психические</span></p><p class="s70"><span class="s57">расстройства</span></p></div></div></div><img src="x-apple-ql-id://BD3B7FD6-1190-4020-A6F2-39A206C3376B/x-apple-ql-magic/7C330EAE-5341-4A7D-8577-8A5FE7052FEC.pdf" style="position:absolute; top:334; left:283; width:74; height:74;"><img src="x-apple-ql-id://B83D94B9-629A-425E-9C5D-93973B7500F5/x-apple-ql-magic/564C50D3-5968-4C60-967F-86FD27639D60.pdf