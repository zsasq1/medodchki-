</style><div class="slide" style="top:0; left:0;"><div class="s0"></div><div style="position:absolute; top:156; left:54; width:612; height:90;"><div class="s50"><div class="s49"><p class="s51"><span class="s52">СПАСИБО ЗА ВНИМАНИЕ!</span></p></div></div></div><div style="position:absolute; top:510; left:714; width:6; height:12;"><div class="s53"><div class="s1"><p class="s54"> </p></div></div></div></div></body></html>