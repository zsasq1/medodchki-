ht:74;"><div style="position:absolute; top:231; left:322; width:255; height:30;"><div class="s132"><div class="s13"><p class="s68"><span class="s57">Ятрогенная</span></p></div></div></div><img src="x-apple-ql-id://B74D8220-8DF9-4255-9DB0-6476C36F4031/x-apple-ql-magic/287FD614-45F7-4B20-8CF6-076B5D5536D1.pdf" style="position:absolute; top:323; left:323; width:227; height:74;"><div style="position:absolute; top:345; left:352; width:168; height:30;"><div class="s133"><div class="s13"><p class="s68"><span class="s57">Парциальная</span></p></div></div></div><img src="x-apple-ql-id://A4F54513-9812-4084-929F-611C87B5B684/x-apple-ql-magic/E8E18C7E-FCF9-4890-A376-F596A0C4BA09.pdf" style="position:absolute; top:272; left:323; width:227; height:74;"><div style="position:absolute; top:294; left:352; width:168; height:30;"><div class="s133"><div class="s13"><p class="s68"><span class="s57">Тотальная</span></p></div></div></div><img src="x-apple-ql-id://A10FCCF6-3CB6-4569-94A8-D479FBBCF24F/x-apple-ql-magic/52C47328-54AD-41D8-92E2-5B1FCC6A2262.pdf" style="position:absolute; top:425; left:5; width:272; height:102;"><div style="position:absolute; top:448; left:36; width:209; height:56;"><div class="s131"><div class="s13"><p class="s68"><span class="s55">По клиническому </span></p><p class="s70"><span class="s55">течению</span></p></div></div></div><img src="x-apple-ql-id://E1E17E7B-4C4E-45C8-B2EB-9A2771481D13/x-apple-ql-magic/099F70D7-E4FB-4184-9C29-E611A59180D3.pdf" style="position:absolute; top:459; left:323; width:227; height:74;"><div style="position:absolute; top:481; left:352; width:168; height:30;"><div class="s133"><div class="s13"><p class="s68"><span class="s57">Хроническая</span></p></div></div></div><img src="x-apple-ql-id://51358C0E-6524-4951-810E-280E34A292A1/x-apple-ql-magic/855641DD-48E1-482C-9C87-9F066720169D.pdf" style="position:absolute; top:408; left:323; width:227; height:74;"><div style="position:absolute; top:430; left:352; width:168; height:30;"><div class="s133"><div class="s13"><p class="s68"><span class="s57">Острая</span></p></div></div></div><img src="x-apple-ql-id://39135483-B79F-448E-933F-882A183BA6BF/x-apple-ql-magic/3D1F0209-2E91-403C-9E6A-2298A6A7A76C.pdf" style="position:absolute; top:125; left:238; width:90; height:90;"><img src="x-apple-ql-id://3803FB3C-BEEC-4C36-8E95-9B95A69886E5/x-apple-ql-magic/8F63EEB8-1DC1-48D2-A932-72E1EC0FB2E0.pdf" style="position:absolute; top:174; left:238; width:90; height:44;"><img src="x-apple-ql-id://89ADD6A7-140B-42B9-A10D-5D6061C91E7D/x-apple-ql-magic/2C4D11E8-DFC9-4261-BCE6-A2DECF492609.pdf" style="position:absolute; top:176; left:238; width:90; height:91;"><img src="x-apple-ql-id://868CE35D-B8DC-46CE-8C14-AFB751878EC2/x-apple-ql-magic/36A64C91-603E-447A-9C06-8EB3F0BB8028.pdf" style="position:absolute; top:289; left:238; width:125; height:68;"><img src="x-apple-ql-id://83C92775-76F4-4DBC-967F-20E1869D9E42/x-apple-ql-magic/CCCA557B-2D1E-46F7-9A10-AD1DA22704E3.pdf" style="position:absolute; top:317; left:238; width:125; height:63;"><img src="x-apple-ql-id://0E75B53C-F066-49D9-9095-9D2BEB9B9AAE/x-apple-ql-magic/EFFF62F0-D7FB-4047-8E55-EA936A2E97B6.pdf" style="position:absolute; top:425; left:238; width:125; height:69;"><img src="x-apple-ql-id://184AE06A-605D-4887-9797-211E212FEF1F/x-apple-ql-magic/99B85FF1-64AC-4423-B59C-03EF7153FA13.pdf" style="position:absolute; top:454; left:238; width:125; height:63;"></div><style type="text/css">
