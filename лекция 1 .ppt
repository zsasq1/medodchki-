</style><div class="slide" style="top:0; left:0;"><div class="s0"></div><div style="position:absolute; top:0; left:36; width:648; height:54;"><div class="s76"><div class="s1"><p class="s24"><span class="s77">CD20, </span><span class="s77">ДВККЛ, х1000</span></p></div></div></div><div style="position:absolute; top:156; left:54; width:612; height:324;"><div class="s10"><p class="s60"> </p></div></div><img src="x-apple-ql-id://52E39685-B177-496B-89CA-E23301C8CB3D/x-apple-ql-magic/1ABACC11-C4FB-4FEF-95D2-E5B3CA384DFD.jpg" style="position:absolute; top:54; left:36; width:657; height:470;"><div style="position:absolute; top:82; left:518; width:141; height:41;"><div class="s10"><p class="s78"><span class="s79">С</span><span class="s79">D</span><span class="s79">20</span></p></div></div></div><div class="slide" style="top:0; left:0;"><div class="s0"></div><div style="position:absolute; top:48; left:54; width:612; height:90;"><div class="s32"><div class="s1"><p class="s74"> </p></div></div></div><div style="position:absolute; top:156; left:54; width:612; height:324;"><div class="s10"><p class="s60"> </p></div></div><img src="x-apple-ql-id://09DBFAF7-F248-4816-B37A-F37EB13F3F2A/x-apple-ql-magic/44ECB526-F0FF-4FC3-945F-8A79C450414C.png" style="position:absolute; top:0; left:0; width:720; height:554;"></div><div class="slide" style="top:0; left:0;"><div class="s0"></div><div style="position:absolute; top:48; left:54; width:612; height:90;"><div class="s32"><div class="s1"><p class="s74"> </p></div></div></div><img src="x-apple-ql-id://5ED615AD-60AA-4F18-A21E-BD882E8E61BD/x-apple-ql-magic/AF431733-2FB4-4EA6-8905-EF64B7F9F7D9.jpg" style="position:absolute; top:14; left:53; width:623; height:525;"></div><style type="text/css">
