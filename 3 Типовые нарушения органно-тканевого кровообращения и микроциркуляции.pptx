</style><div class="slide" style="top:0; left:0;"><div class="s0"></div><div style="position:absolute; top:2; left:36; width:611; height:117;"><div class="s68"><div class="s9"><p class="s69"><span class="s70">Артериальная</span><span class="s70"> </span><span class="s70">гиперемия</span></p></div></div></div><div style="position:absolute; top:171; left:19; width:352; height:262;"><div class="s27"><p class="s26"><span class="s71">Усиление &nbsp;</span><span class="s71">кровотока </span><span class="s72">в &nbsp;</span><span class="s71">органе </span><span class="s72">или</span><span class="s71"> </span><span class="s71">ткани &nbsp;</span><span class="s71">вследствие &nbsp;</span><span class="s71">расширения &nbsp;</span><span class="s71">приводящих &nbsp;</span><span class="s71">артерий</span></p></div></div><div style="position:absolute; top:148; left:412; width:251; height:310; background-image:url(x-apple-ql-id://3F1C8D39-6E9B-48D5-BF67-8A5535E9BF6B/x-apple-ql-magic/C2F3A0F6-BA0B-40D4-915B-2280447F0336.jpg);"><div class="s73"><p class="s74"> </p></div></div></div><div style="position: relative; width:0; height: 0"><div class="loading-slide" style="top:0; left:0;"><div style="position:absolute; top:240; left:0; width:720; height:60; font-family:Arial; font-size:48; text-align:center;">Загрузка…</div></div></div><style type="text/css">
