.s5.s5.s5 {color:#ffcc66; font-weight:bold; text-shadow:2px 2px 2px #000; font-size:36;}
.s6.s6.s6 {color:#ffcc66; font-weight:bold; text-shadow:2px 2px 2px #000; font-size:36; font-family:"Arial";}
