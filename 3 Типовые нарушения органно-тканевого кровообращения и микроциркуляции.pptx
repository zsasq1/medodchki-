</style><div class="slide" style="top:0; left:0;"><div class="s0"></div><div style="position:absolute; top:22; left:89; width:518; height:44;"><div class="s25"><div class="s9"><p class="s26"> </p></div></div></div><div style="position:absolute; top:45; left:42; width:652; height:378;"><div class="s27"><p class="s28"><span class="s29">К </span><span class="s30">микроциркуляторному </span><span class="s30">руслу</span><span class="s31"> </span><span class="s30">относятся</span></p><p class="s32"><span class="s30">сосуды диаметром </span><span class="s30">до 100</span><span class="s30"> </span><span class="s30">мкм:</span></p><p class="s33"> </p><p class="s33"><span class="s34">а</span><span class="s34">р</span><span class="s34">т</span><span class="s34">ери</span><span class="s34">о</span><span class="s34">л</span><span class="s34">ы, прекапилляры, </span><span class="s34"> &nbsp;</span><span class="s34">к</span><span class="s34">апилляры</span><span class="s34">, посткапилляры,</span><span class="s34"> &nbsp;</span><span class="s34">венулы</span></p><p class="s35"><span class="s34">артерио-венозные</span><span class="s34"> </span><span class="s34">анастомозы</span></p></div></div></div><div style="position: relative; width:0; height: 0"><div class="loading-slide" style="top:0; left:0;"><div style="position:absolute; top:240; left:0; width:720; height:60; font-family:Arial; font-size:48; text-align:center;">Загрузка…</div></div></div><style type="text/css">
