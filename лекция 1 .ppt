.s3.s3.s3 {text-align:center; padding-bottom:0px; font-family:"Arial"; font-size:40;}
.s4.s4.s4 {color:#ffcc66; font-weight:bold; text-shadow:2px 2px 2px #000; font-size:40;}
.s5.s5.s5 {color:#ffcc66; font-weight:bold; text-shadow:2px 2px 2px #000; font-size:28; font-family:"Arial";}
.s6.s6.s6 {color:#ffcc66; font-weight:bold; text-shadow:2px 2px 2px #000; font-size:28;}
