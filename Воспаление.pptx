</style><div class="slide" style="top:0; left:0;"><div class="s14"></div><div style="position:absolute; top:0; left:642; width:78; height:540; background-image:url(x-apple-ql-id://3D608309-28A4-4583-A0BE-C4C273454DC9/x-apple-ql-magic/699572DF-FEA5-442F-BBA7-51E3A0F4D783.jpg);"><div class="s15"><div class="s1"><p class="s3"> </p></div></div></div><div style="position:absolute; top:25; left:36; width:570; height:90;"><div class="s22"><div class="s4"><p class="s23"><span class="s34">Альтерация</span></p></div></div></div><div style="position:absolute; top:175; left:109; width:0; height:28; background-color:#ffcdde;"><div class="s41"><p class="s42"> </p></div></div><div style="position:absolute; top:175; left:121; width:0; height:28; background-color:#ffcdde;"><div class="s41"><p class="s42"> </p></div></div><div style="position:absolute; top:156; left:26; width:0; height:28; background-color:#ffcdde;"><div class="s41"><p class="s42"> </p></div></div><div style="position:absolute; top:175; left:199; width:0; height:27; background-color:#ffcdde;"><div class="s41"><p class="s42"> </p></div></div><div style="position:absolute; top:175; left:283; width:0; height:28; background-color:#ffcdde;"><div class="s41"><p class="s42"> </p></div></div><div style="position:absolute; top:368; left:517; width:0; height:28; background-color:#ffcdde;"><div class="s41"><p class="s42"> </p></div></div><div style="position:absolute; top:384; left:402; width:0; height:28; background-color:#ffcdde;"><div class="s41"><p class="s42"> </p></div></div><div style="position:absolute; top:398; left:3; width:108; height:88; background-color:#ffcdde; border-style:solid;border-width:thin;border-color:black;"><div class="s10"><p class="s42"> </p></div></div><div style="position:absolute; top:396; left:122; width:129; height:88; background-color:#ffcdde; border-style:solid;border-width:thin;border-color:black;"><div class="s10"><p class="s42"> </p></div></div><div style="position:absolute; top:396; left:614; width:105; height:88; background-color:#ffcdde; border-style:solid;border-width:thin;border-color:black;"><div class="s10"><p class="s42"> </p></div></div><div style="position:absolute; top:166; left:371; width:0; height:33; background-color:#ffcdde;"><div class="s41"><p class="s3"> </p></div></div><div style="position:absolute; top:145; left:0; width:653; height:105; background-color:#ffcdde;"><div class="s41"><p class="s42"><span class="s43">(от лат. </span><span class="s43">altera</span><span class="s43">re</span><span class="s43"> – изменять) – дистрофия, повреждение ткани, </span></p><p class="s42"><span class="s43">нарушение в ней питания (трофики) и обмена веществ, </span></p><p class="s42"><span class="s43">ее структуры и функции.</span></p><p class="s42"> </p></div></div><div style="position:absolute; top:434; left:20; width:73; height:16; background-color:#ffcdde;"><div class="s41"><p class="s42"><span class="s44">СТРУКТУР</span></p></div></div><div style="position:absolute; top:432; left:131; width:112; height:16; background-color:#ffcdde;"><div class="s41"><p class="s42"><span class="s44">МЕТАБОЛИЗМА</span></p></div></div><div style="position:absolute; top:396; left:440; width:159; height:88; background-color:#ffcdde; border-style:solid;border-width:thin;border-color:black;"><div class="s10"><p class="s3"><span class="s44">СПЕКТРА </span><span class="s45">БАВ</span><span class="s44"> </span></p><p class="s46"><span class="s44">(ОБРАЗОВАНИЕ</span></p><p class="s3"><span class="s44">МЕДИАТОРОВ </span></p><p class="s3"><span class="s44"> ВОСПАЛЕНИЯ</span><span class="s47">)</span></p></div></div><div style="position:absolute; top:424; left:628; width:74; height:16; background-color:#ffcdde;"><div class="s41"><p class="s42"><span class="s44">ФУНКЦИИ</span></p></div></div><div style="position:absolute; top:396; left:266; width:159; height:88; background-color:#ffcdde; border-style:solid;border-width:thin;border-color:black;"><div class="s10"><p class="s3">