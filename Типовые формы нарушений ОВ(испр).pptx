osition:absolute; top:213; left:500; width:202; height:135; border-style:solid;border-width:thin;border-color:black;"><div class="s98"><div class="s1"><p class="s3"><span class="s95">НАРУШЕНИЕ </span></p><p class="s3"><span class="s95">АМИНОКИСЛОТНОГО </span></p><p class="s3"><span class="s95">СОСТАВА </span></p><p class="s3"><span class="s95">ПОТРЕБЛЯЕМОГО </span></p><p class="s3"><span class="s95">БЕЛКА </span></p><p class="s3"><span class="s95">(дефицит/избыток)</span></p></div></div></div><img src="x-apple-ql-id://B1399FAF-C554-45F5-BB9E-A481BEC2F39E/x-apple-ql-magic/36FBE8C3-6D04-4C83-AB3B-A608EB2EDB90.pdf" style="position:absolute; top:295; left:498; width:153; height:40;"><div style="position:absolute; top:428; left:377; width:317; height:73; border-style:solid;border-width:thin;border-color:black;"><div class="s99"><div class="s1"><p class="s3"><span class="s95">ОТРИЦАТЕЛЬНЫЙ АЗОТИСТЫЙ </span></p><p class="s3"><span class="s95">БАЛАНС</span></p></div></div></div><div style="position:absolute; top:389; left:14; width:238; height:68; border-style:solid;border-width:thin;border-color:black;"><div class="s100"><div class="s1"><p class="s3"><span class="s95">ПОЛОЖИТЕЛЬНЫЙ </span></p><p class="s3"><span class="s95">АЗОТИСТЫЙ </span></p><p class="s3"><span class="s95">БАЛАНС</span></p></div></div></div><img src="x-apple-ql-id://03EC556B-86CE-477B-9042-8F31D5D61D68/x-apple-ql-magic/17DFBE21-6B96-4BB1-9EBE-C37137F29034.pdf" style="position:absolute; top:340; left:333; width:205; height:136;"><img src="x-apple-ql-id://F95FDEFA-A275-43D7-AA2D-EF3F3DC24A86/x-apple-ql-magic/B72E2002-1D74-48BA-8311-A41115D9F5BB.pdf" style="position:absolute; top:62; left:549; width:78; height:170;"><img src="x-apple-ql-id://9D3DC085-CC52-40DF-8E50-8DC3287198E1/x-apple-ql-magic/E8430DA0-5267-4A73-AA62-E742870BB064.pdf" style="position:absolute; top:62; left:334; width:78; height:57;"><img src="x-apple-ql-id://E3F11616-8DE6-49BB-BA92-ED7C1F9FF60E/x-apple-ql-magic/2CE8A8C2-BFC0-437E-9A2A-867