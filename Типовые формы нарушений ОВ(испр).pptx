B1B860.pdf" style="position:absolute; top:-20; left:686; width:42; height:88;"><img src="x-apple-ql-id://ABCD568E-94A4-43E1-9C02-C8297F3D37FB/x-apple-ql-magic/AF2C1C73-3D94-4C19-8E6F-588CE4493053.pdf" style="position:absolute; top:-19; left:682; width:44; height:86;"><img src="x-apple-ql-id://B38F842C-C6A1-4B9E-99D9-E30D404BC165/x-apple-ql-magic/3C0DA2AE-AAFA-4C84-A076-2020301AE11F.pdf" style="position:absolute; top:-19; left:678; width:40; height:86;"><div style="position:absolute; top:133; left:48; width:623; height:327;"><div class="s11"><p class="s135"><span class="s159">Липиды - это химические соединения, нерастворимые в воде, но растворимые в хлороформе или спирте. </span></p><p class="s135"><span class="s83">К липидам относятся </span></p><p class="s190"><span class="s165">-</span><span class="s83">ненасыщенные и насыщенные жирные кислоты, </span></p><p class="s190"><span class="s165">-</span><span class="s83">моно-, </span><span class="s83">ди</span><span class="s83">-, </span><span class="s83">триацилглицеролы</span><span class="s83">, </span></p><p class="s190"><span class="s165">-</span><span class="s83">холестерин,</span></p><p class="s190"><span class="s165">-</span><span class="s83">фосфолипиды, </span></p><p class="s190"><span class="s165">-</span><span class="s83">гликолипиды, стерины и воски. </span></p><p class="s191"> </p><p class="s135"><span class="s83">По составу они делятся на простые, сложные липиды и стероиды. </span></p></div></div><img src="x-apple-ql-id://974F06BA-2CFC-43FD-920B-E6F0E9BA7891/x-apple-ql-magic/EC9ED7D5-32A8-47C0-B456-1354CA552B30.pdf" style="position:absolute; top:367; left:138; width:57; height:91;"></div><div style="position: relative; width:0; height: 0"><div class="loading-slide" style="top:0; left:0;"><div style="position:absolute; top:240; left:0; width:720; height:60; font-family:Arial; font-size:48; text-align:center;">Загрузка…</div></div></div><div class="slide" style="top:0; left:0;"><div class="s0"></div><img src="x-apple-ql-id://7D5FF967-0C8F-48DB-BAEB-D384AFD0A378/x-apple-ql-magic/8AAD0DCE-988B-48FA-943D-62B8B02B547D.pdf" style="position:absolute; top:8; left:-19; width:760; height:46;"><div style="position:absolute; top:0; left:0; width:720; height:24; background-color:#424456;"><div class="s16"><div class="s1"><p class="s3"> </p></div></div></div><div style="position:absolute; top:24; left:0; width:720; height:7; background-color:#438086;"><div class="s17"><div class="s1"><p class="s3"> </p></div></div></div><div style="position:absolute; top:28; left:425; width:294; height:7; background-color:#438086;"><div class="s2"><div class="s1"><p class="s3"> </p></div></div></div><img src="x-apple-ql-id://218C87D0-9271-4A2E-BBC0-0702FE66F8E9/x-apple-ql-magic/2A462330-F364-4783-B53E-A92C6CDCE9C0.pdf" style="position:absolute; top:14; left:406; width:334; height:54;"><img src="x-apple-ql-id://1AC63722-3A74-4CA7-9E18-C27CC458BD9D/x-apple-ql-magic/037DCC4D-600C-4595-9995-7C8E446E2927.pdf" style="position:absolute; top:19; left:405; width:281; height:42;"><img src="x-apple-ql-id://0FC2DFAD-C43B-4B9D-B4DF-2F282BB7A35F/x-apple-ql-magic/890CA0A2-F8DB-4A35-B70A-1A50F58848B6.pdf" style="position:absolute; top:26; left:560; width:166; height:42;"><img src="x-apple-ql-id://7A1337CA-E83A-445D-895D-61F6B5EEA8DD/x-apple-ql-magic/4DD987D6-85A7-425B-9697-A06D150048B0.pdf" style="position:absolute; top:-20; left:695; width:44; height:88;"><img src="x-apple-ql-id://9940AE18-86B7-4B95-B438-0926F33E3A26/x-apple-ql-magic/E980231A-E6EF-45A7-A7D1-2E6689A3572F.pdf" style="position:absolute; top:-20; left:692; width:42; height:88;"><img src="x-apple-ql-id://7C293BC7-6938-45E3-844A-E5F9ECE2C89B/x-apple-ql-magic/4D915973-A68E-4664-885D-E1339D625157.pdf" style="position:absolute; top:-20; left:690; width:40; height:88;"><img src="x-apple-ql-id://DA251ED8-DD6A-4EA4-BBA5-B3E06F40523A/x-apple-ql-magic/B52DF6A8-CD59-44DA-A01C-4BC363B1B860.pdf" style="position:absolute; top:-20; left:686; width:42; height:88;"><img src="x-apple-ql-id://ABCD568E-94A4-43E1-9C02-C8297F3D37FB/x-apple-ql-magic/AF2C1C73-3D94-4C19-8E6F-588CE4493053.pdf" style="position:absolute; top:-19; left:682; width:44; height:86;"><img src="x-apple-ql-id://B38F842C-C6A1-4B9E-99D9-E30D404BC165/x-apple-ql-magic/3C0DA2AE-AAFA-4C84-A076-2020301AE11F.pdf" style="position:absolute; top:-19; left:678; width:40; height:86;"><div style="position:absolute; top:71; left:36; width:648; height:84;"><div class="s69"><div class="s1"><p class="s19"><span class="s101">Нарушения липидного обмена. Этиология</span></p></div></div></div><img src="x-apple-ql-id://974F06BA-2CFC-43FD-920B-E6F0E9BA7891/x-apple-ql-magic/EC9ED7D5-32A8-47C0-B456-1354CA552B30.pdf" style="position:absolute; top:367; left:138; width:57; height:91;"><div style="position:absolute; top:177; left:36; width:648; height:340;"><div class="s11"><p class="s21"><span class="s22">•</span><span class="s23">нарушения процессов переваривания и всасывания липидов; </span></p><p class="s75"><span class="s22">•</span><span class="s23">нарушения транспорта липидов кровью и перехода их в ткани; </span></p><p class="s75"><span class="s22">•</span><span class="s23">нарушения процессов накопления и мобилизации &nbsp;липидов; </span></p><p class="s75"><span class="s22">•</span><span class="s23">нарушения межуточного обмена липидов в периферических тканях.</span></p><p class="s75"> </p></div></div></div><style type="text/css">
