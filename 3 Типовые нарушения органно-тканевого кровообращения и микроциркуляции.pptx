</style><div class="slide" style="top:0; left:0;"><div class="s0"></div><div style="position:absolute; top:21; left:14; width:680; height:88;"><div class="s59"><div class="s9"><p class="s60"><span class="s61">Основные формы на</span><span class="s61">рушени</span><span class="s61">й</span><span class="s61"> </span><span class="s61">местного кровообращения</span></p></div></div></div><div style="position:absolute; top:116; left:25; width:680; height:398;"><div class="s62"><p class="s63"><span class="s64">1. А</span><span class="s64">ртериальная</span><span class="s64"> </span><span class="s64">гиперемия</span></p><p class="s63"><span class="s64">2. И</span><span class="s64">шемия</span></p><p class="s63"><span class="s64">3. В</span><span class="s64">енозная</span><span class="s64"> </span><span class="s64">гиперемия</span></p><p class="s63"><span class="s64">4. С</span><span class="s64">таз</span><span class="s64"> &nbsp;</span></p><p class="s65"> </p><p class="s66"><span class="s67">! Т</span><span class="s67">ромбоз</span><span class="s67"> </span><span class="s67">и</span><span class="s67"> </span><span class="s67">э</span><span class="s67">м</span><span class="s67">б</span><span class="s67">о</span><span class="s67">лия</span><span class="s67"> приводят к нарушениям местного кровообращения</span></p></div></div></div><style type="text/css">
